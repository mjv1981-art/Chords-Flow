# Required for downloading gated MuScriptor weights. Supply securely in hosting
# settings; never use VITE_HF_TOKEN or put a real token in this file.
# HF_TOKEN=
# MUSCRIPTOR_MODEL=small
# MUSCRIPTOR_THREADS=2
# Optional absolute path to an isolated runtime on another cloud host.
# MUSCRIPTOR_PYTHON=
# Set 0 only for a lightweight MIDI-import/library deployment.
# BAYANFLOW_ENABLE_MUSCRIPTOR=1
# Optional browser access password; leave unset for public access.
# BAYANFLOW_ACCESS_PASSWORD=
